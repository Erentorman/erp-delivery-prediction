# ============================================================
# ERP Delivery Prediction — Environment Variable Template
# Copy this file to .env and fill in real values locally.
# NEVER commit .env to version control.
# ============================================================

# ----- PostgreSQL -----
POSTGRES_DB=erp_delivery
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=change_me_postgres_password

# ----- API (App.Api) -----
ASPNETCORE_ENVIRONMENT=Development
CONNECTION_STRING=Host=postgres;Port=5432;Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long
JWT_ISSUER=erp-delivery-prediction
JWT_AUDIENCE=erp-delivery-prediction-clients

# ----- Mock ERP (MockErp.Api) -----
MOCK_ERP_BASE_URL=http://mock-erp:8080

# ----- AI Prediction Service -----
AI_PREDICTION_BASE_URL=http://ai-prediction:8000
AI_PREDICTION_TIMEOUT_MS=3000
AI_MODEL_PATH=/app/models/model.pkl
AI_FEATURE_SCHEMA_VERSION=1
AI_MODEL_VERSION=1
AI_TRAINING_DATASET_VERSION=1

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:5000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ----- Published ports (development only) -----
FRONTEND_PORT=3000
API_PORT=5000
